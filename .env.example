# Environment variable reference for SC2AM.
# SC2AM does not load .env automatically. Export selected variables in your shell.
# See docs/cli-and-config-contract.md for precedence and validation rules.

# SC2AM_DOWNLOAD_DIR=~/Downloads/sc2am
# SC2AM_PLAYLIST="My Playlist"
# SC2AM_OPEN_MUSIC=true
# SC2AM_CONTINUE_ON_ERROR=false
# SC2AM_LOG_LEVEL=INFO
# SC2AM_LOG_FILE=~/sc2am.log

# Compatibility settings, currently inactive:
# SC2AM_MUSIC_LIBRARY=
# SC2AM_KEEP_DOWNLOADS=true
# SC2AM_NORMALIZE_METADATA=true
# SC2AM_SKIP_EXISTING=false
