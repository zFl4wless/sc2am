{
  "name": "sc2am-product-film",
  "private": true,
  "version": "0.0.0",
  "description": "Illustrated SC2AM product film; not a filmed device demo",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "hyperframes preview",
    "check": "hyperframes check --at 2.5,7.5,13.5,19.5,24.5,29.5,34",
